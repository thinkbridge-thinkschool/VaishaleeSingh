<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Enables "dotnet user-secrets", which stores development secrets in
         the user profile rather than anywhere inside this repository. The id
         itself is not a secret; it is just the folder name the secrets are
         filed under. -->
    <UserSecretsId>36bf2d17-1d4d-4872-9b74-d762a143e6b4</UserSecretsId>
  </PropertyGroup>

  <!-- ================================================================
       Container image (Day 5)
       ================================================================
       .NET 8+ builds an OCI image straight from the project, so there is
       no Dockerfile here and nothing to keep in sync with this file. The
       publish command and the reasoning behind these properties are in
       docs/containerising.md.

       ContainerRepository, not ContainerImageName: the property was
       renamed in .NET 8, and the old name is the deprecated spelling.
       Both are kept here (see below) so the local/manual build in
       docs/containerising.md keeps producing quotes-api, not an
       SDK-default name derived from the assembly.

       ContainerFamily and ContainerBaseImage are gone. They pinned this
       project to the Alpine base image, which docs/azd-deployment.md
       found does not survive being built through azd: azd's built-in
       .NET SDK container integration (host: containerapp, language:
       dotnet) always invokes dotnet publish with -r linux-x64
       hardcoded, and there is no azure.yaml setting or hook that changes
       that RID for a language: dotnet service. A command-line -r is a
       global MSBuild property; it wins over anything this project could
       set, so there was never a way to force linux-musl-x64 through azd.
       Left in place, ContainerFamily: alpine still selected the Alpine
       base image while the RID stayed glibc, reproducing section 1 of
       docs/containerising.md on every azd deploy: the image built,
       started, and died the instant EF Core touched SQLite
       (fcntl64: symbol not found).

       Removing both properties does not change the manual exercise's
       outcome. dotnet publish (still the documented command in docs/containerising.md)
       requests the musl RID explicitly on the command line, and the .NET SDK resolves a
       musl-x64 RID to the Alpine base image on its own: that always
       did the real work; ContainerFamily was redundant with it, not
       load-bearing. What changes is only the azd path: with no family
       pinned, azd's own -r linux-x64 now pairs with the SDK's default
       (Debian-based, glibc) image, which actually matches the RID it
       publishes with, instead of a musl base paired with a glibc binary.
       Full detail, including the live crash log, is in
       docs/azd-deployment.md.
  -->
  <PropertyGroup>
    <ContainerRepository>quotes-api</ContainerRepository>
    <ContainerImageName>quotes-api</ContainerImageName>

    <!-- Both, deliberately. The documentation says ContainerImageTag
         falls back to $(Version), so this file first set Version alone on
         the theory that one version number is better than two. The image
         that came out was tagged "latest". Whatever the fallback actually
         keys off, it is not this, so the tag is stated outright: an image
         tagged "latest" is unversioned in practice, and cannot be rolled
         back to. Version stays because it also stamps the assembly. -->
    <Version>0.1.0</Version>
    <ContainerImageTag>0.1.0</ContainerImageTag>
  </PropertyGroup>

  <ItemGroup>
    <!-- The ASP.NET base images already set ASPNETCORE_HTTP_PORTS=8080 and
         the SDK infers the exposed port from it. Stating it explicitly
         costs nothing and means `docker inspect` documents the contract
         rather than leaving a reader to know that default. -->
    <ContainerPort Include="8080" Type="tcp" />

    <!-- SQLite writes next to the working directory by default
         ("Data Source=quotes.db"), and PublishContainer runs the app as a
         non-root user that does not own /app, so the migration on startup
         would fail on a read only path. /tmp is writable by any user in
         the base image.

         This is a deliberately temporary home. A file database inside a
         container is the wrong shape regardless of where it is put: the
         data dies with the container, and two replicas do not share it.
         The repository already has the answer for anything real, in the
         SQL Server provider and migrations under
         QuotesApi.Migrations.SqlServer. See docs/containerising.md. -->
    <ContainerEnvironmentVariable Include="ConnectionStrings__DefaultConnection" Value="Data Source=/tmp/quotes.db" />
  </ItemGroup>

  <ItemGroup>
    <!-- Day 24: the Angular bundle, when it has been built into spa/.
         See the "Angular front end" block in Program.cs for why it is served
         from here rather than from Azure Static Web Apps.

         The glob matches nothing when spa/ is absent, which is the normal case
         locally and in ci.yml -- only the deploy workflow builds into it. That
         is deliberate: an empty glob is silent, whereas an SDK item pointing at
         a required-but-missing directory fails the build.

         CopyToPublishDirectory rather than CopyToOutputDirectory: these files
         are needed in the published image, not in bin/ during `dotnet run`
         (where the SPA is served by `ng serve` on its own port and this app is
         hit cross-origin on :5059 -- see environment.ts).

         Link strips the leading "spa\" from each entry's relative path, then
         puts it back. Without it, the SDK preserves the path relative to the
         project file for files outside wwwroot inconsistently across globs, and
         the bundle lands one directory deeper than Program.cs looks for it --
         which presents as a 404 on every SPA route with no error anywhere. -->
    <Content Include="spa\**\*" CopyToPublishDirectory="PreserveNewest" Link="spa\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Day 12: Dapper, for the hot read path only. EF Core stays the default
         for everything else; see Day12/docs for the rule this repo follows. -->
    <PackageReference Include="Azure.Messaging.ServiceBus" Version="7.20.1" />
    <PackageReference Include="Microsoft.Extensions.Azure" Version="1.10.0" />
    <PackageReference Include="Dapper" Version="2.1.35" />
    <PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.5.1" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.6.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
          <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" Version="10.9.0" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.10" />
    <!-- Microsoft's wrapper over Polly v8: it is what supplies
         AddResilienceHandler and the Http*StrategyOptions types used in
         Extensions/ResilienceExtensions.cs. Polly itself comes in
         transitively; referencing it separately would risk pinning a
         different version than this package was built against.

         Version pinned to match the other Microsoft.Extensions.* packages
         in this file. This library ships out of dotnet/extensions on the
         runtime's own cadence, so 10.0.x is the line that pairs with
         net10.0 — but the exact patch could not be verified from the
         sandbox this was written in (no network path to nuget.org). If
         restore fails on "package not found" rather than a real problem,
         run `dotnet add QuotesApi package Microsoft.Extensions.Http.Resilience`
         to pin whatever the current 10.0.x actually is. -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.9.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" Version="1.17.0-beta.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.19.2" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.19.2" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
  </ItemGroup>

</Project>
