{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=quotes.db"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "OpenTelemetry": "Warning",
        "Azure": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [TraceId:{TraceId}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": ["FromLogContext"]
  },
  "Jwt": {
    "Issuer": "https://yourapp.com",
    "Audience": "quotes-api",
    "AccessTokenLifetime": "00:15:00"
  },
  "Pagination": {
    "MaxPageSize": 100
  },
  "Resilience": {
    "TotalTimeout": "00:00:10",
    "AttemptTimeout": "00:00:03",
    "Retry": {
      "MaxAttempts": 3,
      "BaseDelay": "00:00:01",
      "IdempotentOnly": true
    },
    "CircuitBreaker": {
      "FailureRatio": 0.5,
      "MinimumThroughput": 10,
      "SamplingDuration": "00:00:30",
      "BreakDuration": "00:00:15"
    },
    "Bulkhead": {
      "PermitLimit": 4,
      "QueueLimit": 8
    }
  },
  "BackgroundJobs": {
    "QueueCapacity": 100,
    "ProcessingDelaySeconds": 3,
    "StatusRetentionMinutes": 60,
    "ShutdownTimeoutSeconds": 15
  },
  "AzureAd": {
    "Authority": "https://login.microsoftonline.com/f774bb68-0575-4cd2-9d4c-3b4e593d1110/v2.0",
    "ClientId": "91566dbd-d857-488a-858d-475e60b309b7",
    "TenantId": "f774bb68-0575-4cd2-9d4c-3b4e593d1110",
    "Audience": "api://quotes-api/access"
  },
  "Cache": {
    "Enabled": false,
    "Expiration": "00:05:00",
    "LocalCacheExpiration": "00:00:30",
    "MaximumPayloadBytes": 1048576,
    "GenerationCacheDuration": "00:00:01",
    "MaxCachedPage": 20,
    "Redis": {
      "ConnectionString": "",
      "InstanceName": "quotes:"
    }
  },
  "Outbox": {
    "RelayEnabled": false,
    "PollInterval": "00:00:05",
    "BatchSize": 20,
    "LeaseDuration": "00:01:00",
    "MaxAttempts": 5,
    "RetentionDays": 7,
    "RetentionSweepInterval": "06:00:00",
    "PendingAgeWarningThreshold": "00:05:00"
  },
  "ServiceBus": {
    "Enabled": false,
    "FullyQualifiedNamespace": "",
    "TopicName": "quote-events",
    "AuditSubscription": "audit",
    "SearchIndexSubscription": "search-index",
    "MaxConcurrentCalls": 4,
    "PrefetchCount": 0,
    "MaxAutoLockRenewalMinutes": 5
  }
}
