# =============================================================================
# Day 17 -- configuration, in one place
# =============================================================================
#
# Copy to `.env` and fill in. `.env` is gitignored; this template is not.
#
#   cp Day17/.env.example Day17/.env
#
# READ THIS BEFORE PUTTING A SECRET IN HERE.
#
# This file is a MAP of the configuration, and for the non-secret half it is
# also the source. It is deliberately NOT where the secrets live, and that is
# the point of the exercise rather than an inconvenience: Day 17 asks for the
# front end to call the Week-1 API "via Managed Identity (no stored client
# secret)". A .env holding an API credential is exactly the thing that
# requirement forbids. There are only two secrets in this whole project, and
# neither belongs in a file on disk:
#
#   * the Static Web Apps deployment token -> GitHub Actions secrets
#   * Jwt:Secret                           -> dotnet user-secrets
#
# and the credential the API call itself uses is not stored anywhere at all,
# because a managed identity is issued at runtime by the platform. Both are
# covered at the bottom of this file, with the command or place that owns them.
#
# Everything above that line is public: an audience, a tenant id, a hostname.
# The Entra values are already committed in
# Day7/piece2/QuotesApi/appsettings.json -- they are identifiers, not keys.


# -----------------------------------------------------------------------------
# 1. Azure resources (non-secret -- these are names and ids)
# -----------------------------------------------------------------------------

AZURE_SUBSCRIPTION_ID=33c82ead-36a8-4d8f-b969-d8476690c224

# TWO resource groups, which is easy to get wrong: the Static Web App and the
# Container App do not live together.
SWA_RESOURCE_GROUP=rg-quotes-api
API_RESOURCE_GROUP=thinkschool-azd-rg

# The Static Web App created for Day 17. SKU MUST be Standard: the Free tier
# cannot have a linked backend, and the linked backend is what holds the
# managed identity. On Free, the managed-identity half of this exercise is not
# buildable at all.
SWA_NAME=quotes-web-day17
SWA_SKU=Standard
SWA_DEFAULT_HOSTNAME=yellow-river-074adb50f.7.azurestaticapps.net

# The custom domain. A subdomain, not the apex: an apex on SWA needs ALIAS /
# ANAME support or an Azure DNS zone, where a subdomain is a plain CNAME plus a
# TXT for validation.
SWA_CUSTOM_DOMAIN=

# The Week-1 API, already live on Azure Container Apps since Day 5.
API_BASE_URL=https://quotes-api-cowork.whitestone-71ebd55e.centralindia.azurecontainerapps.io

# The linked Functions backend that holds the managed identity. Not created yet
# -- see Day17/docs/day17-implementation-plan.md step 4.
BFF_FUNCTION_APP_NAME=
# Output of: az functionapp identity show -n <app> -g <rg> --query principalId -o tsv
# Worth recording, because verifying the deployment means proving the `oid` in
# the outbound token equals THIS value -- that is what makes "the call carries a
# managed-identity token" checkable rather than asserted.
BFF_MANAGED_IDENTITY_PRINCIPAL_ID=


# -----------------------------------------------------------------------------
# 2. Entra ID (non-secret -- identifiers, already in appsettings.json)
# -----------------------------------------------------------------------------

AZURE_TENANT_ID=803dced7-0a24-4857-8be8-280047561e95

# The API's app registration. NOTE: there is deliberately no
# AZURE_CLIENT_SECRET to go with this client id. If you ever find yourself
# adding one, the managed-identity design has been abandoned -- stop and read
# Day17/docs/day17-implementation-plan.md section 0.
AZURE_CLIENT_ID=SETME02-legacy-api-app-id

# The API's Application ID URI -- and therefore the `aud` claim of every token
# Entra issues for it. Read from the app registration in the portal, because the
# portal and appsettings.json disagree:
#
#   app registration : api://SETME02-legacy-api-app-id   <- real
#   appsettings.json : api://quotes-api/access                       <- WRONG
#
# `api://quotes-api/access` is the SCOPE string, not the audience. The portal's
# help text on that field is explicit: "It is the prefix for scopes and in access
# tokens, it is the value of the audience claim." So the API is configured to
# validate an audience Entra can never issue -- the EntraId scheme has never been
# able to accept a real token.
#
# Renaming the App ID URI to api://quotes-api is NOT possible; Azure rejects it:
# "All newly added URIs must contain a tenant verified domain, tenant ID, or app
# ID, as per the default tenant policy of your organization." So the API's config
# is the side that changes -- set AzureAd__Audience on the Container App.
API_AUDIENCE=api://SETME02-legacy-api-app-id

# What a client requests. Audience + "/" + scope name. Confirmed in the portal:
# scope name `access`, consentable by "Admins and users", so an ordinary user can
# consent without an admin.
API_SCOPE=api://SETME02-legacy-api-app-id/access

# SPA redirect URIs registered on the app registration. Single-page application
# platform => auth-code + PKCE with NO client secret; the registration has no
# secret at all, which is the property Day 17 is really about.
ENTRA_SPA_REDIRECT_PROD=https://yellow-river-074adb50f.7.azurestaticapps.net
ENTRA_SPA_REDIRECT_DEV=http://localhost:4200

# The app role granted to the BFF's managed identity, and gated on by the API.
API_APP_ROLE=Quotes.Proxy


# -----------------------------------------------------------------------------
# 3. Front end (non-secret, and it CANNOT be otherwise)
# -----------------------------------------------------------------------------
#
# Angular is a browser application: everything it is built with ships to the
# browser in the bundle. There is no such thing as a secret front-end env var
# -- a "hidden" value here is one View Source away. Never add a token to this
# section.
#
# These two are also NOT read from this file at runtime. Angular resolves them
# at BUILD time from src/environments/, and production is `apiBaseUrl: ''` on
# purpose -- an empty base makes every request same-origin (`/api/quotes`),
# which is what routes the browser through the SWA `/api` backend and removes
# CORS from production entirely. Recorded here so the values exist in one place;
# change them in src/environments/, not here.

NG_API_BASE_URL_DEV=http://localhost:5059
NG_API_BASE_URL_PROD=


# -----------------------------------------------------------------------------
# 4. The BFF's own app settings (non-secret)
# -----------------------------------------------------------------------------
#
# These are the ONLY two settings the Function App gets. Part of verifying this
# deployment is running `az functionapp config appsettings list` and confirming
# nothing else is there -- no client secret, no connection string to the API.
# The double underscore is .NET's nesting convention: Api__BaseUrl binds to
# BffOptions.BaseUrl under the "Api" section.

Api__BaseUrl=https://quotes-api-cowork.whitestone-71ebd55e.centralindia.azurecontainerapps.io
Api__Audience=api://quotes-api/access


# =============================================================================
# 5. SECRETS -- these do NOT go in this file
# =============================================================================
#
# Listed so the map is complete, with the mechanism that actually owns each.
# Left blank here on purpose. Filling them in would put a live credential in a
# file that a stray `git add -f` can commit.
#
# --- Static Web Apps deployment token -----------------------------------------
# Authorises CI to upload static content. It grants nothing against the API, so
# "no stored client secret" is still true with this in place -- but it is a real
# secret and the distinction is worth stating rather than blurring.
#
# Where it lives:  GitHub -> Settings -> Secrets and variables -> Actions
# Secret name:     AZURE_STATIC_WEB_APPS_API_TOKEN
# Where to get it: Azure portal -> the Static Web App -> Manage deployment token
#
# One gotcha, learned the hard way: the GitHub secret box is a textarea, so a
# stray newline saved with the token produces
#   "No matching Static Web App was found or the api key was invalid"
# which looks nothing like a whitespace problem. The deploy workflow now has a
# lengths-only check that catches it.
#
# AZURE_STATIC_WEB_APPS_API_TOKEN=   <- do not fill in; use GitHub secrets
#
# --- JWT signing key ----------------------------------------------------------
# The Week-1 API's own token-signing key. Deliberately absent from
# appsettings.json since Day 3; startup validation fails fast with a readable
# message if it is missing or under 32 characters.
#
# IT LIVES IN TWO DIFFERENT PLACES, and conflating them wastes time:
#
#   * running locally  -> dotnet user-secrets (command below)
#   * the deployed API -> a secret on the Container App `quotes-api-cowork`,
#                         surfaced to the process as Jwt__Secret
#
# The deployed one is ALREADY set and must be: the Container App answers
# /health, and the API refuses to start without a valid key. So nothing is
# missing here for the deployment to work -- this section is about local runs.
#
# Rotating it (which you should, if the value has ever been pasted somewhere it
# does not belong) means changing it in BOTH places. Every previously issued
# access and refresh token stops validating the moment it changes, so every
# signed-in session is logged out -- that is the intended behaviour of rotating
# a signing key, not a bug.
#
#   dotnet user-secrets --project Day5/piece2/QuotesApi set "Jwt:Secret" "<32+ chars>"
#
# Jwt__Secret=   <- do not fill in; use dotnet user-secrets
#
# --- The API credential -------------------------------------------------------
# There isn't one, and that is the deliverable. The BFF calls the API with a
# token from DefaultAzureCredential, issued at runtime by the platform's
# identity endpoint. Nothing is stored, so there is nothing to put here, rotate,
# or leak. The negative test that proves it: remove the app-role assignment from
# the managed identity and confirm the call starts returning 403. If it still
# succeeds, something other than the managed identity was authorising it.
