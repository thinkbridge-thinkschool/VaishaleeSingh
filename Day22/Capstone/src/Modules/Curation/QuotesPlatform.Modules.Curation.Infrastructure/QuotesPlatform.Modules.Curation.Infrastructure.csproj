<Project Sdk="Microsoft.NET.Sdk">

  <!-- INFRASTRUCTURE: EF Core, the module's DbContext, repository
       implementations of the Application's ports, and the module's DI
       registration. Its schema is "curation" and it declares no foreign key
       to any other schema — see the design: a cross-schema FK is a join
       waiting to be written, and a join across a boundary is the boundary
       gone. -->
  <ItemGroup>
    <ProjectReference Include="..\QuotesPlatform.Modules.Curation.Application\QuotesPlatform.Modules.Curation.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Azure.Messaging.ServiceBus" Version="7.18.2" />
    <PackageReference Include="Azure.Identity" Version="1.14.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />
  </ItemGroup>

</Project>
