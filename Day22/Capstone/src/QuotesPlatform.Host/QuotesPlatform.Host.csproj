<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- COMPOSITION ONLY. The Host references each module's Infrastructure so it
       can call that module's Add*Module extension, and nothing else. It holds
       no domain types, no DbContext and no handler.

       It does NOT reference any module's Domain: ArchitectureTests asserts
       that, because a Host that can see a domain type is a Host where the
       first "quick fix" puts business logic in an endpoint. -->
  <ItemGroup>
    <ProjectReference Include="..\Modules\Catalog\QuotesPlatform.Modules.Catalog.Infrastructure\QuotesPlatform.Modules.Catalog.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\Curation\QuotesPlatform.Modules.Curation.Infrastructure\QuotesPlatform.Modules.Curation.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\Publishing\QuotesPlatform.Modules.Publishing.Infrastructure\QuotesPlatform.Modules.Publishing.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\Moderation\QuotesPlatform.Modules.Moderation.Infrastructure\QuotesPlatform.Modules.Moderation.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Day 32: the Host validates Entra tokens. Plain JwtBearer rather than the
       Microsoft.Identity.Web package family: Entra tokens validate against an
       authority and an audience, and this is one dependency at the 10.0.10 the
       rest of this repository already uses. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
  </ItemGroup>
</Project>
